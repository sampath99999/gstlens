# Model served by the API
GSTLENS_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
GSTLENS_ADAPTER_PATH=artifacts/qwen05b-lora/adapter
GSTLENS_DEVICE=auto
GSTLENS_DTYPE=float16
GSTLENS_MAX_NEW_TOKENS=640

# hf = local transformers model, openai = any OpenAI-compatible endpoint (Ollama)
GSTLENS_BACKEND=hf
GSTLENS_BASE_PROMPT=few_shot

# Only used when GSTLENS_BACKEND=openai or for the Ollama comparison in the eval
GSTLENS_OPENAI_BASE_URL=http://localhost:11434/v1
GSTLENS_OPENAI_API_KEY=ollama
GSTLENS_OPENAI_MODEL=qwen2.5:3b
